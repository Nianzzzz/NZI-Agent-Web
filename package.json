{
  "name": "nzi-agent-web",
  "private": true,
  "version": "0.1.0",
  "description": "NZi Agent Web — Agent Runtime Orchestration Platform",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @nzi/backend prisma generate",
    "db:migrate": "pnpm --filter @nzi/backend prisma migrate dev",
    "db:push": "pnpm --filter @nzi/backend prisma db push",
    "db:studio": "pnpm --filter @nzi/backend prisma studio",
    "install:all": "pnpm install && pnpm --filter @nzi/backend install && pnpm --filter @nzi/frontend install"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
