{
  "name": "@nzi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test:sdk": "tsx src/engine/tests/pi-sdk-test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/redis": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@nzi/shared-types": "workspace:*",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "dotenv": "^17.4.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
