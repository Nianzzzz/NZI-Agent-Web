// Prisma Schema for NZi Agent Web
// Phase 1: Core tables (User, Tenant, Session, Message, AgentEvent)
// Phase 2 placeholders: SessionNode, ArenaMatch, ArenaVote

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Multi-Tenancy ──────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships TenantMember[]
  sessions    Session[]

  @@map("users")
}

model Tenant {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members    TenantMember[]
  sessions   Session[]
  engineConfigs EngineConfig[]
  settings   Json?

  @@map("tenants")
}

model TenantMember {
  id        String       @id @default(cuid())
  userId    String
  tenantId  String
  role      TenantRole   @default(MEMBER)
  createdAt DateTime     @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("tenant_members")
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Engine Configuration ──────────────────────────────────────────

model EngineConfig {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider         EngineProvider
  apiKeyEncrypted  String?
  apiKeyIv         String?
  apiKeyTag        String?
  model            String?
  thinkingLevel    ThinkingLevel?
  isEnabled        Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, provider])
  @@map("engine_configs")
}

enum EngineProvider {
  PI
  GROK
}

enum ThinkingLevel {
  OFF
  LOW
  MEDIUM
  HIGH
}

// ─── Session ───────────────────────────────────────────────────────

model Session {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  engine          EngineProvider @default(PI) // 保留字段向后兼容，默认 PI
  status          SessionStatus @default(ACTIVE)
  parentSessionId String?
  parentSession   Session?    @relation("SessionTree", fields: [parentSessionId], references: [id])
  rootNodeId      String?
  summary         String?
  metadata        Json?
  /** 关联的 Arena 对战 ID（仅 Arena 会话有此值） */
  arenaMatchId    String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages    Message[]
  events      AgentEvent[]
  children    Session[] @relation("SessionTree")

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([parentSessionId])
  @@index([arenaMatchId])
  @@map("sessions")
}

enum SessionStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// ─── Message ───────────────────────────────────────────────────────

model Message {
  id           String        @id @default(cuid())
  sessionId    String
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rootEventId  String?
  rootEvent    AgentEvent?   @relation("RootMessage", fields: [rootEventId], references: [id])
  role         MessageRole
  content      String
  reasoning    String?
  toolCalls    Json?
  tokenUsage   Json?
  latencyMs    Int?
  status       MessageStatus @default(COMPLETED)
  timelineNodes Json?
  /** Arena 对战侧标识（A=PI, B=GROK），仅 Arena 会话的消息有此值 */
  arenaSide    String?
  createdAt    DateTime      @default(now())

  @@index([sessionId, createdAt])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL_RESULT
}

enum MessageStatus {
  COMPLETED
  INTERRUPTED
}

// ─── AgentEvent (Core Event Stream) ────────────────────────────────

model AgentEvent {
  id            String       @id @default(cuid())
  sessionId     String
  session       Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  provider      EngineProvider
  eventType     AgentEventType
  parentEventId String?
  parentEvent   AgentEvent?  @relation("EventTree", fields: [parentEventId], references: [id])
  children      AgentEvent[] @relation("EventTree")
  nodeId        String       @unique
  isFork        Boolean      @default(false)
  isArena       Boolean      @default(false)
  content       String?
  traceId       String
  durationMs    Int?
  tokenUsage    Json?
  eventData     Json?
  rootMessages  Message[]    @relation("RootMessage")
  createdAt     DateTime     @default(now())

  @@index([sessionId, createdAt])
  @@index([sessionId, parentEventId])
  @@index([traceId])
  @@index([nodeId])
  @@map("agent_events")
}

enum AgentEventType {
  AGENT_START
  AGENT_END
  TURN_START
  TURN_END
  MESSAGE_START
  MESSAGE_UPDATE
  MESSAGE_END
  TOOL_EXECUTION_START
  TOOL_EXECUTION_UPDATE
  TOOL_EXECUTION_END
  COMPACTION_START
  COMPACTION_END
  ERROR
}

// ─── Arena Match ──────────────────────────────────────────────────

model ArenaMatch {
  id            String          @id @default(cuid())
  tenantId      String
  userId        String
  prompt        String
  thinkingLevel ThinkingLevel?
  status        ArenaMatchStatus @default(RUNNING)
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  votes         ArenaVote[]

  @@index([tenantId, createdAt])
  @@map("arena_matches")
}

enum ArenaMatchStatus {
  RUNNING
  COMPLETED
}

model ArenaVote {
  id        String       @id @default(cuid())
  matchId   String
  match     ArenaMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  provider  EngineProvider
  createdAt DateTime     @default(now())

  @@index([matchId])
  @@map("arena_votes")
}

// ─── Session Node (Phase 2 placeholder) ────────────────────────────

model SessionNode {
  id        String   @id
  sessionId String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("session_nodes")
}

// ─── Phase 3: Web Search, Skills, MCP ────────────────────────────────

model WebSearchConfig {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String   @default("duckduckgo") // duckduckgo | serpapi
  apiKey      String?  // AES-256-GCM encrypted
  apiKeyIv    String?
  apiKeyTag   String?
  maxResults  Int      @default(5)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, provider])
  @@map("web_search_configs")
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String
  category    String   @default("custom") // coding | writing | analysis | devops | custom
  version     String   @default("1.0.0")
  author      String
  authorType  String   @default("system") // system | community | user
  icon        String   @default("sparkles")
  tags        Json     @default("[]")
  prompt      String   // 核心：注入到 system prompt 的指令
  tools       Json     @default("[]") // 允许的工具列表
  downloads   Int      @default(0)
  rating      Float    @default(0)
  isPublic    Boolean  @default(true)
  tenantId    String?  // 用户自定义 skill 的归属租户
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills  UserSkill[]

  @@index([category])
  @@index([author])
  @@map("skills")
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@map("user_skills")
}

model McpServer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  transport   String   @default("stdio") // stdio | sse | streamable
  command     String?  // stdio 传输的命令
  url         String?  // SSE/streamable 传输的 URL
  env         Json?    // 环境变量
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, name]) // 同一租户下不允许同名服务器重复添加
  @@map("mcp_servers")
}
